APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///./data/truthlayer.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=8
IMAGE_RETENTION_DAYS=7
ALLOWED_ORIGINS=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=25
GEMINI_MAX_RETRIES=1
TAVILY_API_KEY=
TAVILY_ENABLED=true
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=20
MIN_OCR_CONFIDENCE=0.55
MAX_SEARCH_QUERIES=5
OFFLINE_DATASET_DIR=./data/datasets
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD_PER_MINUTE=60
RATE_LIMIT_PROCESSING_PER_MINUTE=60
RATE_LIMIT_GENERAL_PER_MINUTE=300
